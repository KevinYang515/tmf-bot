//| LB7S (2026-11-25): + 空單追太晚不加碼 (比前一交易日收盤跌≥7% 不再加空單 Add/G) |
//+------------------------------------------------------------------+
//| Trend Follower V38.40 - Session Separation [日夜盤股性分流]      |
//| v30d (2026-11-05): v30b + 修正60分K趨勢濾網「即時重繪」— 交易邏輯不變
//|   歷史K棒: 與v30完全相同 (取該5分K收盤時已收完的60分K, = Python引擎)
//|   即時K棒: 原寫法會取「還沒收完」的60分K → 實盤≠回測; 改為只用已收完的60分K
//|            (若這根5分K剛好是60分K最後一根, 兩者相同, 照用當下值)
//|   成本預設: 手續費380/邊(=30+7點) 滑點0 (實盤圖表滑點必須維持0)
//| v30b (2026-11-05): 僅更新儀表板 — 版本標題改v30、新增 G2量能/多單ADX 兩列 (交易邏輯與v30完全相同)
//|   成本預設對齊Python成本模型R(2026): 手續費每邊85元(40+期交稅約44) / 滑價每邊6 tick
//| v30 (2026-10-31): v29 + 兩項改動 (1分K引擎 2020-03~2026-10 回測)  |
//|   ① G2 量能閘門: 盤中累積量 < 過去20時段同時點平均 ×0.728 →     |
//|      不開新首倉 (加碼不受限)                                      |
//|   ② 多單 ADX 門檻 20→30                                          |
//|   2024+ 淨利 220→251萬, 日MDD -37→-23萬 (每邊4點);               |
//|   實盤成本模型(ATR縮放滑價+開盤50點) 215→242萬, MDD -41→-25萬     |
//|   ⚠️ 門檻0.728是用永豐MXFR1量算的; TV MXF1!量需先對帳/重算       |
//| v29 (2026-08-23): 在 v28 基礎上疊加第二個獨立驗證過的機制         |
//|                   (詳見 backtest/strategy_v26/                    |
//|                   v38_optimization_20260822.md 的實盤配置附錄)    |
//|   ① [v28 沿用] 空方04:00加碼集中度上限 — 已在TV上手動核對確認     |
//|      2026-06-11 04:50案例正確擋下第2口加碼                        |
//|   ② [v29 新增] 多方母單出場收緊 — l_trailBase 5.0→3.5 ATR         |
//|      (多單停損 l_slMult 維持 3.0 不變)。回測(2024-2026,實盤       |
//|      TimeStop+Cooldown配置下): L_Cmd淨利+64,470、勝率+6.3個百分點  |
//|      MDD再改善-56,540，但總淨利微幅下降-0.4% (風險/L_Cmd品質      |
//|      換不到淨利提升，屬用小額期望值換更低尾部風險的取捨)          |
//|   ⚠️ 兩機制動的是不同部分(空方加碼深度 vs 多方出場距離)，理論上   |
//|      互不衝突，但尚未在Python引擎或TV上做過「疊加」本身的專門     |
//|      回測驗證，此版本本身就是這個疊加驗證的起點                   |
//| 其餘邏輯與 v27/v28 完全相同 (TimeStop/Cooldown/OpenBlock等)       |
//+------------------------------------------------------------------+
//@version=5
strategy("V38.1125_v30e_LB7S Session", overlay=true, initial_capital=400000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=4, commission_type=strategy.commission.cash_per_contract, commission_value=380, slippage=0)

// ==========================================
// 1. 核心參數
// ==========================================
grp_time = "🚀 加速設定"
useDateFilter = input.bool(true, "啟用起始日過濾", group=grp_time)
startYear     = input.int(2022, "起始年", group=grp_time)
startMonth    = input.int(1,    "起始月", group=grp_time)
startDay      = input.int(1,    "起始日", group=grp_time)
startTime = timestamp(startYear, startMonth, startDay, 0, 0)
bool inDateRange = not useDateFilter or time >= startTime

grp_core = "多時框濾網 (MTF)"
useMtf = input.bool(true, "啟用 60分K 大趨勢濾網", group=grp_core)
mtfPeriod = input.timeframe("60", "大趨勢週期", group=grp_core)

grp_local = "5分K 引擎設定"
l_emaLenLong  = input.int(130, "做多母單 EMA 長度", group=grp_local)
l_cmdExitLen  = input.int(50, "L_Cmd 快速防守 EMA 長度", group=grp_local)
s_cmdExitLen  = input.int(40, "S_Cmd 快速防守 EMA 長度", group=grp_local)
l_emaLenShort = input.int(125, "做空母單 EMA 長度", group=grp_local)

// ★★★ 日夜盤分流 ★★★
grp_session = "🌗 日夜盤股性分流 (Session)"
useSession = input.bool(true, "啟用日夜盤動態追蹤", group=grp_session)
g_trailMultDay   = input.float(0.8, "☀️ 日盤游擊追蹤 (ATR)", group=grp_session, step=0.1, tooltip="台灣法人主導，趨勢連貫，適合緊迫盯人")
g_trailMultNight = input.float(1.5, "🌙 夜盤游擊追蹤 (ATR)", group=grp_session, step=0.1, tooltip="美股主導，上下洗盤劇烈，需放寬防守避免被洗")

grp_g = "⚔️ 第四階游擊單"
useGuerrilla = input.bool(true, "啟用第四階游擊單", group=grp_g)
useGuerrillaLong = input.bool(false, "多單也啟用游擊單 (v30e 預設關)", group=grp_g)
fastEmaLen   = input.int(35, "游擊單防守 EMA 長度", group=grp_g, step=1)
g_slMult     = input.float(200.0, "游擊單專屬停損 (200=無)", group=grp_g, step=10.0)

grp_filter = "ADX 趨勢強度濾網"
useAdx      = input.bool(true, "啟用 ADX 濾網", group=grp_filter)
adxLen      = input.int(14, "ADX 長度", group=grp_filter)
adxThresh   = input.int(30, "ADX 門檻 (L_Cmd 用)", group=grp_filter, tooltip="★ v30: 20→30 (2026-10-31 1分K回測, 2024+ 淨利 233.9→250.7萬, 日MDD -35→-23萬; 實盤成本模型下 227→242萬; v29上 27~35 皆過關, 40/45 不過)")

grp_risk = "風險管理"
l_slMult    = input.float(3.0, "多單停損 (ATR)", group=grp_risk)
l_trailBase = input.float(3.5, "多單母單追蹤 (ATR)", group=grp_risk, tooltip="★ v29: 由 5.0 收緊至 3.5 (2026-08-22本機2.5年回測驗證)。L_Cmd淨利+64,470/勝率+6.3pp/MDD-56,540，總淨利-0.4%(近乎打平)")
l_trailAdd  = input.float(3.8, "多單加碼追蹤 (ATR)", group=grp_risk)
l_pyramid_dist = input.float(1.2, "多單加碼間距 (ATR)", group=grp_risk)
be_trigger  = input.float(2.0, "保本觸發門檻 (ATR 倍數)", group=grp_risk)

s_slMult    = input.float(2.5, "空單停損 (ATR)", group=grp_risk)
s_trailMult = input.float(3.0, "空單母單追蹤 (ATR)", group=grp_risk)
s_pyramid_dist = input.float(1.0, "空單加碼間距 (ATR)", group=grp_risk)

// ★★★ v27 新增參數 ★★★
grp_v27 = "🆕 v27 優化 (2026-07-07 本機 2.5年回測驗證)"
useTimeStop  = input.bool(true, "① TimeStop 滯留單時間停損", group=grp_v27, tooltip="任何一口持倉超過 N 小時仍未獲利 → 下一根開盤平掉該口。回測 8~12 小時皆有效，10 最佳；6 小時以下反而有害")
staleHours   = input.float(10.0, "  滯留時數門檻 (小時, 含收盤/週末)", group=grp_v27, step=1.0)
useCooldown  = input.bool(true, "② Cooldown 出場後冷卻", group=grp_v27, tooltip="Trend Rev 或 Cmd_Fast 出場後 N 分鐘內不開新首倉 (加碼不受限)，防止盤整日雙巴鏈")
cooldownMin  = input.int(30, "  冷卻分鐘數", group=grp_v27)
useOpenBlock = input.bool(false, "③ OpenBlock 開盤 08:45~08:59 禁新倉", group=grp_v27, tooltip="低DD配置: 淨利 -6% 換 MDD -23%。預設關閉；若與開盤突破策略並行或需要壓低保證金佔用時開啟")

// ★★★ v28 新增參數 ★★★
grp_v28 = "🆕 v28 優化 (2026-08-23 加碼虧損歸因分析後驗證)"
useShortPyramidCap = input.bool(true, "① 空方特定時段加碼集中度上限", group=grp_v28, tooltip="指定時段訊號進場的空單, 加碼(Add)+游擊(G)合計最多N口, 直到母單觸及保本(2.0 ATR)才解除限制。回測(實盤TimeStop+Cooldown配置下): MDD -24%, 總淨利-3.4%(保留96.6%), 近3/6個月窗口皆穩健。已於TV手動核對2026-06-11 04:50案例確認正確擋單")
shortCapHour       = input.int(4, "  限制時段 (小時, 24hr制, Asia/Taipei)", group=grp_v28, minval=0, maxval=23)
shortCapMaxOrders  = input.int(1, "  未保本前最多加碼口數", group=grp_v28, minval=0)

// ★ v30: G2 量能閘門 — 盤中累積量 / 過去20個同盤別同時點累積量平均 < 門檻 → 不開新首倉 (加碼不受限)
grp_v30 = "🆕 v30 量能閘門 (G2)"
useVolGate     = input.bool(true, "① G2 低量不開首倉", group=grp_v30, tooltip="盤中累積量(本盤開盤到這根K)除以過去20個交易時段同一時點的累積量平均, 低於門檻就不開新的 L_Cmd/S_Cmd。門檻0.728=2020-23首倉第20百分位(永豐MXFR1量)。TV MXF1!量若不同需重算")
volGateThresh  = input.float(0.728, "  門檻 (相對量)", group=grp_v30, step=0.01)
volGateMinN    = input.int(5, "  最少樣本數 (不足則不擋)", group=grp_v30, minval=1)

// ==========================================
// 2. 指標與時間計算
// ==========================================
atrVal = ta.atr(14)
volMA  = ta.sma(volume, 20)
isVolSpike = volume > volMA * 2.0
emaLocalLong  = ta.ema(close, l_emaLenLong)
emaLocalShort = ta.ema(close, l_emaLenShort)
emaFast       = ta.ema(close, fastEmaLen)
emaCmdExit    = ta.ema(close, l_cmdExitLen)
emaSCmdExit    = ta.ema(close, s_cmdExitLen)

// ★ v30d: 60分K濾網防重繪
[mtfBullNow, mtfBearNow, htfCloseT] = request.security(syminfo.tickerid, mtfPeriod, [close > ta.ema(close, l_emaLenLong), close < ta.ema(close, l_emaLenShort), time_close], lookahead=barmerge.lookahead_off)
[mtfBullPrev, mtfBearPrev] = request.security(syminfo.tickerid, mtfPeriod, [(close > ta.ema(close, l_emaLenLong))[1], (close < ta.ema(close, l_emaLenShort))[1]], lookahead=barmerge.lookahead_on)
bool htfLastBar = time_close == htfCloseT
bool useConfirmedHtf = barstate.isrealtime and not htfLastBar
bool isMtfBull = useConfirmedHtf ? mtfBullPrev : mtfBullNow
bool isMtfBear = useConfirmedHtf ? mtfBearPrev : mtfBearNow

bool finalMtfBull = not useMtf or isMtfBull
bool finalMtfBear = not useMtf or isMtfBear

[diplus, diminus, adxVal] = ta.dmi(adxLen, adxLen)
bool isAdxOk = not useAdx or (adxVal > adxThresh)

// --- 時間判定 ---
int t_h = hour(time, "Asia/Taipei")
bool isBaseToxic = (t_h >= 15 and t_h <= 20) or (t_h == 1) or (t_h == 2)
// ★ v27-③: 開盤 08:45~08:59 禁新倉 (預設關)
if useOpenBlock and t_h == 8
    isBaseToxic := true
bool isLongToxic = isBaseToxic or (t_h == 4)
bool isShortToxic = isBaseToxic or (t_h == 21)

// ★ 日夜盤判定邏輯 (日盤: 08:00~13:59)
bool isDaySession = (t_h >= 8 and t_h <= 13)

// ★ v30: G2 盤中累積相對量 (同時點=同一根5分K開盤時刻; 日夜盤時刻不重疊, 故時刻即隱含盤別)
var float sessCumVol = 0.0
bool newSession = barstate.isfirst or isDaySession != isDaySession[1] or (time - time[1]) > 2 * 3600000
sessCumVol := newSession ? volume : sessCumVol + volume
int clockSlot = int(math.floor((hour(time, "Asia/Taipei") * 60 + minute(time, "Asia/Taipei")) / 5))
var array<float> volHist = array.new_float(288 * 20, na)
var array<int> volCnt = array.new_int(288, 0)
float volRel = na
if useVolGate
    int nPrev = math.min(array.get(volCnt, clockSlot), 20)
    if nPrev >= volGateMinN
        float s = 0.0
        for k = 0 to nPrev - 1
            s += array.get(volHist, clockSlot * 20 + k)
        volRel := sessCumVol / (s / nPrev)
    // 寫入本根 (環狀, 保留最近20筆; 先算後寫 = 只用過去的時段)
    int c = array.get(volCnt, clockSlot)
    array.set(volHist, clockSlot * 20 + (c % 20), sessCumVol)
    array.set(volCnt, clockSlot, c + 1)
bool volGateBlock = useVolGate and not na(volRel) and volRel < volGateThresh
float current_g_trail = useSession ? (isDaySession ? g_trailMultDay : g_trailMultNight) : g_trailMultDay

// ★ v27-②: 冷卻狀態 (lastChopExit 在出場區塊更新, 此處讀前一根的值)
var int lastChopExit = 0
bool inCooldown = useCooldown and lastChopExit > 0 and (time_close - lastChopExit) < cooldownMin * 60000

// ==========================================
// 3. 進場與加碼
// ==========================================
var float baseATR = na
var float addATR = na
var float gATR = na
// ★ v28-①: 空方加碼集中度上限狀態 (同一活躍空方campaign內持續累計/持有)
var int shortPyramidOrders = 0
var bool shortBeArmedForCap = false

float posSize = strategy.position_size
float avgPrice = strategy.position_avg_price

// ★ LB7S (2026-11-25, V067): 空單追太晚不加碼 — 價格已比「前一交易日收盤」下跌 ≥ 門檻% 時，不再新增空單 Add / G
//   （多單不受影響；空單母單與既有部位不受影響；不會平倉）
grp_lb = "★ LB7S 空單追太晚不加碼"
useLateAddBlock = input.bool(true, "啟用：比前一交易日收盤跌≥門檻%不再加空單(Add/G)", group=grp_lb)
lateAddPct = input.float(7.0, "門檻 (%)", group=grp_lb, minval=0.1, step=0.5)
// 交易日歸屬與 Python 引擎相同：K棒收盤時間 >= 15:00 (Asia/Taipei) 屬於下一個交易日
int _lbCloseH = hour(time_close, "Asia/Taipei")
int _lbDayKey = int(math.floor((time_close + 8 * 3600000 + (_lbCloseH >= 15 ? 86400000 : 0)) / 86400000))
var float lbPrevClose = na
if _lbDayKey != _lbDayKey[1]
    lbPrevClose := close[1]
bool shortLateAddOk = not useLateAddBlock or na(lbPrevClose) or ((1 - close / lbPrevClose) * 100 < lateAddPct)

if (posSize == 0)
    baseATR := atrVal
    addATR := atrVal
    gATR := atrVal
    shortPyramidOrders := 0
    shortBeArmedForCap := false

// ★ v28-①: 同根K棒即時判斷母單是否已保本 (避免延遲一根才生效)
// 母單參考價與出場區塊的 openPrice 用同一套寫法，確保永遠指向最早的未平倉口(Short_Cmd)
float shortCmdEntryPx = posSize < 0 ? strategy.opentrades.entry_price(strategy.opentrades - strategy.opentrades) : na
bool shortBeArmedNow = posSize < 0 and not na(shortCmdEntryPx) and (shortCmdEntryPx - close) > (baseATR * be_trigger)
if shortBeArmedNow
    shortBeArmedForCap := true
bool shortCapApplies = useShortPyramidCap and t_h == shortCapHour
bool shortPyramidCapOk = not shortCapApplies or shortBeArmedForCap or shortPyramidOrders < shortCapMaxOrders

bool longTrigger  = (ta.crossover(ta.ema(close, 10), ta.ema(close, 30)) or ta.crossover(close, ta.highest(high, 20)[1]))
bool shortTrigger = ta.crossunder(close, ta.lowest(low, 20)[1])

// --- 多單邏輯 ---
if inDateRange
    if (posSize == 0 and not isLongToxic and finalMtfBull and close > emaLocalLong and longTrigger and isAdxOk and not inCooldown and not volGateBlock)
        strategy.entry("Long_Cmd", strategy.long, comment="L_Cmd")
        baseATR := atrVal

    if (posSize > 0 and posSize < 3 and not isLongToxic and finalMtfBull and close > avgPrice + (baseATR * l_pyramid_dist))
        strategy.entry("Long_Add", strategy.long, comment="L_Add")
        addATR := atrVal

    if (posSize == 3 and useGuerrilla and useGuerrillaLong and not isLongToxic and close > avgPrice + (baseATR * l_pyramid_dist))
        strategy.entry("Long_G", strategy.long, comment="L_G_進")
        gATR := atrVal

// --- 空單邏輯 ---
if inDateRange
    if (posSize == 0 and not isShortToxic and finalMtfBear and close < emaLocalShort and shortTrigger and not inCooldown and not volGateBlock)
        strategy.entry("Short_Cmd", strategy.short, comment="S_Cmd")
        baseATR := atrVal
        shortPyramidOrders := 0
        shortBeArmedForCap := false

    if (posSize < 0 and posSize > -3 and shortLateAddOk and shortPyramidCapOk and not isShortToxic and finalMtfBear and close < avgPrice - (baseATR * s_pyramid_dist))
        strategy.entry("Short_Add", strategy.short, comment="S_Add")
        addATR := atrVal
        shortPyramidOrders := shortPyramidOrders + 1

    if (posSize == -3 and shortLateAddOk and useGuerrilla and shortPyramidCapOk and not isShortToxic and close < avgPrice - (baseATR * s_pyramid_dist))
        strategy.entry("Short_G", strategy.short, comment="S_G_進")
        gATR := atrVal
        shortPyramidOrders := shortPyramidOrders + 1

// ==========================================
// 4. 出場邏輯 (動態追蹤防禦)
// ==========================================
fixedOffset = 1
if posSize != 0
    float openPrice = strategy.opentrades.entry_price(strategy.opentrades - strategy.opentrades)
    float currentProfit = 0.0
    float effectiveAddATR = na(addATR) ? baseATR : addATR
    float effectiveGATR = na(gATR) ? effectiveAddATR : gATR

    // --- 多單出場 ---
    if posSize > 0
        currentProfit := close - openPrice
        if currentProfit > (baseATR * be_trigger)
            strategy.exit("L_BE", from_entry="Long_Cmd", stop=openPrice)

        strategy.exit("L_Exit", from_entry="Long_Cmd", trail_points=(baseATR * l_trailBase)/syminfo.mintick, trail_offset=fixedOffset, loss=(baseATR * l_slMult)/syminfo.mintick)
        strategy.exit("L_Exit_Add", from_entry="Long_Add", trail_points=(effectiveAddATR * l_trailAdd)/syminfo.mintick, trail_offset=fixedOffset, loss=(effectiveAddATR * 5.0)/syminfo.mintick)

        if useGuerrilla
            strategy.exit("L_Exit_G", from_entry="Long_G", trail_points=(effectiveGATR * current_g_trail)/syminfo.mintick, trail_offset=fixedOffset, loss=(effectiveGATR * g_slMult)/syminfo.mintick)
            if ta.crossunder(close, emaFast)
                strategy.close("Long_G", comment="L_G_Cut")

        if ta.crossunder(close, emaCmdExit)
            strategy.close("Long_Cmd", comment="L_Cmd_Fast")
            lastChopExit := time_close   // ★ v27-②

        if (ta.crossunder(close, emaLocalLong))
            strategy.close_all(comment="Trend Rev")
            lastChopExit := time_close   // ★ v27-②

    // --- 空單出場 ---
    if posSize < 0
        currentProfit := openPrice - close
        if currentProfit > (baseATR * be_trigger)
            strategy.exit("S_BE", from_entry="Short_Cmd", stop=openPrice)

        strategy.exit("S_Exit", from_entry="Short_Cmd", trail_points=(baseATR * s_trailMult)/syminfo.mintick, trail_offset=fixedOffset, loss=(baseATR * s_slMult)/syminfo.mintick)
        strategy.exit("S_Exit_Add", from_entry="Short_Add", trail_points=(effectiveAddATR * s_trailMult)/syminfo.mintick, trail_offset=fixedOffset, loss=(effectiveAddATR * 4.5)/syminfo.mintick)

        if useGuerrilla
            strategy.exit("S_Exit_G", from_entry="Short_G", trail_points=(effectiveGATR * current_g_trail)/syminfo.mintick, trail_offset=fixedOffset, loss=(effectiveGATR * g_slMult)/syminfo.mintick)
            if ta.crossover(close, emaFast)
                strategy.close("Short_G", comment="S_G_Cut")

        if ta.crossover(close, emaSCmdExit)
            strategy.close("Short_Cmd", comment="S_Cmd_Fast")
            lastChopExit := time_close   // ★ v27-②

        if (ta.crossover(close, emaLocalShort))
            strategy.close_all(comment="Trend Rev")
            lastChopExit := time_close   // ★ v27-②

    // ★ v27-①: TimeStop 滯留單時間停損
    // 逐口檢查: 持倉 >= staleHours 且以自身進場價計仍虧損 → 平掉該口
    // 同 entry ID 多口時以 FIFO 平舊口 (先進的先滯留, 與回測邏輯一致)
    if useTimeStop
        int staleCmd = 0
        int staleAdd = 0
        int staleG = 0
        for i = 0 to strategy.opentrades - 1
            float ep = strategy.opentrades.entry_price(i)
            int   et = strategy.opentrades.entry_time(i)
            bool  losing = posSize > 0 ? close < ep : close > ep
            if losing and (time_close - et) >= staleHours * 3600000
                string eid = strategy.opentrades.entry_id(i)
                if str.contains(eid, "Cmd")
                    staleCmd += 1
                else if str.contains(eid, "Add")
                    staleAdd += 1
                else
                    staleG += 1
        if staleCmd > 0
            strategy.close(posSize > 0 ? "Long_Cmd" : "Short_Cmd", qty=staleCmd, comment="TimeStop")
        if staleAdd > 0
            strategy.close(posSize > 0 ? "Long_Add" : "Short_Add", qty=staleAdd, comment="TimeStop")
        if staleG > 0
            strategy.close(posSize > 0 ? "Long_G" : "Short_G", qty=staleG, comment="TimeStop")

// ==========================================
// 5. 戰情儀表板
// ==========================================
plot(emaLocalLong, color=color.blue, title="EMA Base (Long)")
plot(emaLocalShort, color=color.orange, title="EMA Base (Short)")
plot(useGuerrilla and math.abs(posSize)>0 ? emaFast : na, color=color.fuchsia, title="EMA Fast (Guerrilla)", linewidth=2, style=plot.style_cross)

bgcolor(isBaseToxic ? color.new(color.gray, 90) : na)
bgcolor(volGateBlock ? color.new(color.purple, 92) : na, title="v30 G2 低量擋首倉")

var float mtd_pnl = 0.0
var int mtd_trades = 0
var int mtd_wins = 0
var float mtd_peak = 0.0
var float mtd_max_dd = 0.0

bool new_month = month(time) != month(time[1])
if new_month
    mtd_pnl := 0.0
    mtd_trades := 0
    mtd_wins := 0
    mtd_peak := strategy.equity
    mtd_max_dd := 0.0
else
    mtd_peak := math.max(mtd_peak, strategy.equity)
    mtd_max_dd := math.max(mtd_max_dd, mtd_peak - strategy.equity)

if strategy.closedtrades > strategy.closedtrades[1]
    float last_trade_pnl = strategy.netprofit - strategy.netprofit[1]
    mtd_pnl := mtd_pnl + last_trade_pnl
    mtd_trades := mtd_trades + 1
    if last_trade_pnl > 0
        mtd_wins := mtd_wins + 1

var table board = table.new(position.top_right, 2, 17, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)

if barstate.islast
    table.cell(board, 0, 0, "策略版本", text_color=color.white, bgcolor=color.gray)
    table.cell(board, 1, 0, "V38 v30e (v30d+停用多單G)", text_color=color.white, bgcolor=color.gray)

    float mtd_roi = (mtd_pnl / 400000) * 100
    string mtdStr = str.tostring(mtd_pnl, "#") + " (" + str.tostring(mtd_roi, "#.1") + "%)"
    table.cell(board, 0, 1, "本月損益 (ROI)", text_color=color.white)
    table.cell(board, 1, 1, mtdStr, text_color=mtd_pnl >= 0 ? color.green : color.red)

    table.cell(board, 0, 2, "本月回撤 (MDD)", text_color=color.white)
    table.cell(board, 1, 2, str.tostring(mtd_max_dd, "#"), text_color=color.red)

    string tradeCountStr = str.tostring(mtd_trades) + " 筆 (勝 " + str.tostring(mtd_wins) + ")"
    table.cell(board, 0, 3, "本月交易", text_color=color.white)
    table.cell(board, 1, 3, tradeCountStr, text_color=color.yellow)

    table.cell(board, 0, 4, "-----------", text_color=color.gray)
    table.cell(board, 1, 4, "-----------", text_color=color.gray)

    float curProfitCalc = 0.0
    if posSize > 0
        curProfitCalc := close - strategy.opentrades.entry_price(strategy.opentrades - strategy.opentrades)
    else if posSize < 0
        curProfitCalc := strategy.opentrades.entry_price(strategy.opentrades - strategy.opentrades) - close

    string beStr = "未觸發"
    if posSize != 0
        if curProfitCalc > (baseATR * be_trigger)
            beStr := "已保本 🔒"
        else
            beStr := "距: " + str.tostring((baseATR * be_trigger) - curProfitCalc, "#")
    table.cell(board, 0, 5, "保本機制", text_color=color.white)
    table.cell(board, 1, 5, beStr, text_color=curProfitCalc > (baseATR * be_trigger) ? color.green : color.gray)

    string posText = "空手 ⚪"
    color posColor = color.gray
    if posSize > 0
        if posSize == 4
            posText := "多 (3 + 1游擊) ⚔️"
        else
            posText := "多 (" + str.tostring(math.abs(posSize)) + " 主力) 🔥"
        posColor := color.green
    else if posSize < 0
        if math.abs(posSize) == 4
            posText := "空 (3 + 1游擊) ⚔️"
        else
            posText := "空 (" + str.tostring(math.abs(posSize)) + " 主力) 🛡️"
        posColor := color.red

    table.cell(board, 0, 6, "目前持倉", text_color=color.white)
    table.cell(board, 1, 6, posText, text_color=posColor)

    string mtfStr = finalMtfBull ? "多頭趨勢" : finalMtfBear ? "空頭趨勢" : "盤整"
    color mtfCol = finalMtfBull ? color.green : finalMtfBear ? color.red : color.gray
    table.cell(board, 0, 7, "60分K 趨勢", text_color=color.white)
    table.cell(board, 1, 7, mtfStr, text_color=mtfCol)

    float nextAddPrice = na
    float trendExitPrice = emaLocalLong
    if posSize < 0
        trendExitPrice := emaLocalShort

    string addStr = "無"
    if posSize > 0
        nextAddPrice := avgPrice + (baseATR * l_pyramid_dist)
        if posSize < 3
            addStr := str.tostring(nextAddPrice, "#") + " (主力)"
        else if posSize == 3 and useGuerrilla and useGuerrillaLong
            addStr := str.tostring(nextAddPrice, "#") + " (游擊) ⚔️"
        else
            addStr := "全軍出擊 (Max 4)"
    else if posSize < 0
        nextAddPrice := avgPrice - (baseATR * s_pyramid_dist)
        if posSize > -3
            addStr := str.tostring(nextAddPrice, "#") + " (主力)"
        else if posSize == -3 and useGuerrilla
            addStr := str.tostring(nextAddPrice, "#") + " (游擊) ⚔️"
        else
            addStr := "全軍出擊 (Max 4)"

    table.cell(board, 0, 8, "加碼目標", text_color=color.white)
    table.cell(board, 1, 8, addStr, text_color=color.yellow)

    string exitStr = "無"
    if posSize != 0
        exitStr := str.tostring(trendExitPrice, "#")
    table.cell(board, 0, 9, "主力防守", text_color=color.white)
    table.cell(board, 1, 9, exitStr, text_color=color.orange)

    string fastExitStr = "待命中"
    if math.abs(posSize) == 4 and useGuerrilla
        fastExitStr := str.tostring(emaFast, "#") + " (啟動中)"
    table.cell(board, 0, 10, "游擊防守 (EMA 35)", text_color=color.white)
    table.cell(board, 1, 10, fastExitStr, text_color=math.abs(posSize) == 4 ? color.fuchsia : color.gray)

    string sessionStr = "未啟用"
    if useSession
        sessionStr := isDaySession ? "☀️ 日盤 ("+str.tostring(current_g_trail, "#.1")+" ATR)" : "🌙 夜盤 ("+str.tostring(current_g_trail, "#.1")+" ATR)"
    table.cell(board, 0, 11, "當前股性 / 游擊追蹤", text_color=color.white)
    table.cell(board, 1, 11, sessionStr, text_color=isDaySession ? color.yellow : color.aqua)

    // ★ v27: 冷卻狀態顯示
    string cdStr = "未啟用"
    if useCooldown
        if inCooldown
            cdStr := "❄️ 冷卻中 (剩 " + str.tostring(math.ceil((cooldownMin * 60000 - (time_close - lastChopExit)) / 60000.0), "#") + " 分)"
        else
            cdStr := "✅ 可進場"
    table.cell(board, 0, 12, "v27 冷卻狀態", text_color=color.white)
    table.cell(board, 1, 12, cdStr, text_color=inCooldown ? color.aqua : color.green)

    // ★ v28: 空方特定時段加碼上限狀態顯示
    string spCapStr = "未啟用"
    if useShortPyramidCap
        if posSize < 0 and t_h == shortCapHour
            spCapStr := shortBeArmedForCap ? "✅ 已保本(不限)" : "🔒 已加碼 " + str.tostring(shortPyramidOrders) + "/" + str.tostring(shortCapMaxOrders)
        else
            spCapStr := "待命中 (非" + str.tostring(shortCapHour) + "時空單)"
    table.cell(board, 0, 13, "v28 空方" + str.tostring(shortCapHour) + "時加碼上限", text_color=color.white)
    table.cell(board, 1, 13, spCapStr, text_color=useShortPyramidCap ? color.aqua : color.gray)

    // ★ v30b: G2 量能閘門狀態 (只擋新首倉, 加碼不受限)
    string vgStr = "未啟用"
    color vgCol = color.gray
    if useVolGate
        if na(volRel)
            vgStr := "樣本不足 (不擋)"
        else if volGateBlock
            vgStr := "🚫 低量擋首倉 " + str.tostring(volRel, "0.00") + " < " + str.tostring(volGateThresh, "0.000")
            vgCol := color.purple
        else
            vgStr := "✅ 可開首倉 " + str.tostring(volRel, "0.00") + " ≥ " + str.tostring(volGateThresh, "0.000")
            vgCol := color.green
    table.cell(board, 0, 14, "v30 G2 盤中相對量", text_color=color.white)
    table.cell(board, 1, 14, vgStr, text_color=vgCol)

    // ★ v30b: 多單 ADX 門檻狀態 (只影響 L_Cmd)
    string adxStr = not useAdx ? "未啟用" : (isAdxOk ? "✅ 可開多單 " : "🚫 不開多單 ") + str.tostring(adxVal, "0.0") + (isAdxOk ? " > " : " ≤ ") + str.tostring(adxThresh)
    table.cell(board, 0, 15, "v30 多單 ADX", text_color=color.white)
    table.cell(board, 1, 15, adxStr, text_color=not useAdx ? color.gray : isAdxOk ? color.green : color.red)
